# DevPlat recommended ignore rules

# secrets files
secrets.yaml
**/secrets.yaml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node and build output
node_modules/
dist/
dist-ssr/
*.local

# Environment files
.env
.env.*
!.env.example

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.pyc

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon_

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk

# Linux
.directory
*~

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/build


# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
dist/
.cache/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*

#user generated content (Build artifacts and duplicate root files)
static/
asset-manifest.json
fetch.js
index.html
favicon.*
android-chrome-*
apple-touch-icon.png
manifest.json
robots.txt
browserconfig.xml
mstile-150x150.png
safari-pinned-tab.svg

# User generated content (If these are build outputs, they should be ignored)
public/profile.json
public/blogs.json